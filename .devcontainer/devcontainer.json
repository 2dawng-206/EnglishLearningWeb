{
  "name": "VocabMaster Dev Environment",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "node",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "anthropic.claude-code",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mysql"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "js/ts.tsdk.path": "node_modules/typescript/lib"
      }
    }
  },

  "postCreateCommand": "cd backend && npm install && echo '✅ Backend deps installed. Next: cp .env.example .env, fill in Aiven credentials, add backend/certs/aiven-ca.pem, then npm run start:dev. Frontend not scaffolded yet (Phase 4).'",

  "forwardPorts": [3000, 5173],
  "portsAttributes": {
    "3000": { "label": "NestJS API" },
    "5173": { "label": "Vite Dev Server" }
  }
}
